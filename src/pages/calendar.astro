---
import { AppShell } from "@/components/app/AppShell";
import BaseLayout from "@/layouts/BaseLayout.astro";

const account = Astro.locals.currentAccount;
export const prerender = false;
---

<BaseLayout title="Calendar - Pue Link">
  <AppShell
    client:load
    title="Calendar"
    eyebrow="Playback history"
    description="Browse dates, locations, and videos played by public kiosks."
    accountName={account?.display_name}
    accountRole={account?.role}
  />
</BaseLayout>
