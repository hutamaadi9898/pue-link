---
import { AppShell } from "@/components/app/AppShell";
import BaseLayout from "@/layouts/BaseLayout.astro";

const account = Astro.locals.currentAccount;
export const prerender = false;
---

<BaseLayout title="Kalender - Pue Link">
  <AppShell
    client:load
    title="Kalender"
    eyebrow="Riwayat playback"
    description="Telusuri tanggal, lokasi, dan video yang pernah diputar oleh mesin publik."
    accountName={account?.display_name}
    accountRole={account?.role}
  />
</BaseLayout>
