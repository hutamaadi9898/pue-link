---
import { env } from "cloudflare:workers";
import "@/styles/global.css";

interface Props {
  title?: string;
}

const { title = "Pue Link" } = Astro.props;
const oneSignalAppId = env.PUBLIC_ONESIGNAL_APP_ID || "";
const oneSignalExternalId = Astro.locals.currentAccount?.role === "family_member"
  ? Astro.locals.currentAccount.family_id
  : "";
const shouldLoadOneSignal = Boolean(oneSignalAppId && oneSignalExternalId);
---

<html lang="en" data-language="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {shouldLoadOneSignal && (
      <>
        <script is:inline define:vars={{ oneSignalAppId, oneSignalExternalId }}>
          window.OneSignalDeferred = window.OneSignalDeferred || [];
          window.OneSignalDeferred.push(async function(OneSignal) {
            try {
              await OneSignal.init({
                appId: oneSignalAppId,
                allowLocalhostAsSecureOrigin: true
              });
              if (oneSignalExternalId) {
                await OneSignal.login(oneSignalExternalId);
              }
            } catch (error) {
              window.PueLinkOneSignalInitError = error instanceof Error ? error.message : "OneSignal could not initialize.";
            }
          });
        </script>
        <script src="https://cdn.onesignal.com/sdks/web/v16/OneSignalSDK.page.js" defer></script>
      </>
    )}
  </head>
  <body>
    <slot />
    <button
      class="language-toggle"
      id="language-toggle"
      type="button"
      aria-label="Switch language"
    >
      <span class="i18n-en">中文</span>
      <span class="i18n-zh">English</span>
    </button>
    <script is:inline>
      const root = document.documentElement;
      const button = document.getElementById("language-toggle");
      const savedLanguage = localStorage.getItem("pue-link-language") === "zh" ? "zh" : "en";

      function applyLanguage(language) {
        root.dataset.language = language;
        root.lang = language === "zh" ? "zh-Hant" : "en";
        localStorage.setItem("pue-link-language", language);
      }

      applyLanguage(savedLanguage);
      button?.addEventListener("click", () => {
        applyLanguage(root.dataset.language === "zh" ? "en" : "zh");
      });
    </script>
  </body>
</html>
